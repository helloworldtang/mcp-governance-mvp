# 必填：DeepSeek API Key（OpenAI 兼容协议，Client 的 ReAct Agent 用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：Gateway→Runtime 的教学用共享凭证；多进程必须使用相同值，生产请换 mTLS/JWT
# GATEWAY_RUNTIME_TOKEN=mcp-governance-demo-gateway

# 可选：DeepSeek 模型（默认 deepseek-chat，function calling 稳定即可）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：Gateway 变体（native | explicit），run_demo.sh 第一个参数也覆盖它
# GATEWAY_VARIANT=native

# 可选：默认演示用户（alice=admin | bob=viewer），run_demo.sh --user 也覆盖它
# DEMO_USER=bob
